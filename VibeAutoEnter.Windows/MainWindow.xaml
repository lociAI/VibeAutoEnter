<Window x:Class="VibeAutoEnter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="VibeAutoEnter v1.2 (Windows)"
        Width="400"
        Height="600"
        Background="#1E1E2E"
        Foreground="#CDD6F4"
        ResizeMode="CanMinimize">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="16">
            <TextBlock Text="VibeAutoEnter" FontSize="20" FontWeight="Bold" Foreground="#CBA6F7"/>
            <TextBlock Text="Hands-free vibe coding for Windows CLI &amp; IDEs" FontSize="11" Foreground="#A6ADC8" Margin="0,2,0,12"/>

            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Left">
                        <TextBlock Text="{Binding StatusText}" FontWeight="SemiBold" FontSize="14"/>
                        <TextBlock Text="{Binding EnterPressCount, StringFormat='Total auto-enters: {0}'}" FontSize="11" Foreground="#A6ADC8"/>
                    </StackPanel>
                    <Button DockPanel.Dock="Right" Content="Start / Pause" Click="ToggleMonitoring_Click"
                            Padding="12,6" Background="#89B4FA" Foreground="#1E1E2E" FontWeight="Bold" BorderThickness="0"/>
                </DockPanel>
            </Border>

            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="CLI Auto-Pilot" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="Auto-Accept [y/N], (y/n), proceed prompts" IsChecked="{Binding CliAutoAcceptEnabled}" Foreground="#CDD6F4" Margin="0,0,0,6"/>
                    <CheckBox Content="Auto-Pick number prompts [1-3], choice [1]" IsChecked="{Binding CliAutoPickNumberEnabled}" Foreground="#CDD6F4" Margin="0,0,0,6"/>
                    <CheckBox Content="Auto-Swap &amp; Patrol open terminals" IsChecked="{Binding AutoSwapWindows}" Foreground="#CDD6F4" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding SwapInterval, StringFormat='Swap every {0:F1}s'}" FontSize="11" Foreground="#A6ADC8"/>
                    <Slider Minimum="1.5" Maximum="10.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding SwapInterval}" Margin="0,2,0,8"/>

                    <TextBlock Text="{Binding CliEnterDelay, StringFormat='CLI Enter delay: {0:F1}s'}" FontSize="11" Foreground="#A6ADC8"/>
                    <Slider Minimum="0.2" Maximum="3.0" TickFrequency="0.2" IsSnapToTickEnabled="True" Value="{Binding CliEnterDelay}"/>
                </StackPanel>
            </Border>

            <Border Background="#313244" CornerRadius="8" Padding="12" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="IDE &amp; Completion" FontWeight="SemiBold" Margin="0,0,0,8"/>
                    <CheckBox Content="Auto-press Enter in Cursor / Windsurf / VS Code / Claude" IsChecked="{Binding AutoEnterEnabled}" Foreground="#CDD6F4" Margin="0,0,0,6"/>
                    <CheckBox Content="Play sound on prompt accept" IsChecked="{Binding PlaySoundOnCompletion}" Foreground="#CDD6F4" Margin="0,0,0,6"/>

                    <TextBlock Text="{Binding EnterDelay, StringFormat='IDE Enter delay: {0:F1}s'}" FontSize="11" Foreground="#A6ADC8"/>
                    <Slider Minimum="0.5" Maximum="5.0" TickFrequency="0.5" IsSnapToTickEnabled="True" Value="{Binding EnterDelay}"/>
                </StackPanel>
            </Border>

            <Border Background="#313244" CornerRadius="8" Padding="12">
                <StackPanel>
                    <TextBlock Text="Activity Feed" FontWeight="SemiBold" Margin="0,0,0,6"/>
                    <ListBox ItemsSource="{Binding ActivityLog}" Height="140" Background="#181825" Foreground="#A6E3A1" BorderThickness="0" FontSize="11"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</Window>
